node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Backend: NestJS (TypeScript) ---
coverage/

# --- Evidencias de QA ---
qa/evidencia/

# --- Pruebas end-to-end ---
test-results/
playwright-report/

