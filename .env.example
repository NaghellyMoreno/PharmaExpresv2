# Copia este archivo a .env y completa los valores. Nunca subas .env.
# Solo nombres: sin valores (docs/03-arquitectura.md, "Variables de entorno").

# Base y reloj
DATABASE_URL=
DATABASE_SEED_URL=

# Claves propias
CEDULA_FINGERPRINT_KEY=
EMAIL_FINGERPRINT_KEY=
OTP_PEPPER=
DELIVERY_CODE_ENC_KEY=
DELIVERY_CODE_LOOKUP_KEY=
CONSENT_COOKIE_KEY=

# Web y API
APP_ORIGIN=
PUBLIC_API_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Tareas (SCHEDULER_MODE: qstash | direct)
CRON_SECRET=
SCHEDULER_MODE=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Archivos
BLOB_READ_WRITE_TOKEN=

# OCR (OCR_PROVIDER: azure | capture)
OCR_PROVIDER=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Mensajería (MESSAGING_MODE: live | sandbox | capture; SMS_PROVIDER: textbee | capture; EMAIL_PROVIDER: resend | capture)
MESSAGING_MODE=
MESSAGING_ALLOWLIST=
SMS_PROVIDER=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# Notificaciones web
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Contraseñas (PASSWORD_BREACH_CHECK: pwned | capture)
PASSWORD_BREACH_CHECK=

# Semillas (solo comandos; solo local y vista previa)
SEED_ADMIN_EMAIL=
SEED_DISPENSER_EMAILS=
SEED_DISPENSER_PASSWORD=
